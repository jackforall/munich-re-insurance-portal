# Required
SESSION_SECRET=generate-a-long-random-value
DATABASE_URL=postgresql://user:password@host:5432/database
NODE_ENV=development

# File storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/objects

# Optional S3-compatible storage (AWS S3 / Cloudflare R2 / MinIO)
# STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=your-bucket
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY_ID=your-access-key
# STORAGE_S3_SECRET_ACCESS_KEY=your-secret-key
# STORAGE_S3_ENDPOINT=https://your-s3-compatible-endpoint
# STORAGE_S3_FORCE_PATH_STYLE=false

# Only needed when frontend and API are on different origins.
# CORS_ORIGINS=https://portal.example.com
# COOKIE_SAMESITE=None
# PUBLIC_SITE_URL=https://portal.example.com

PORTAL_SEED_ENABLED=false
PORTAL_SEED_FOUNDER_EMAIL=founder@example.com
PORTAL_SEED_BROKER_EMAIL=broker@example.com
PORTAL_SEED_CLIENT_EMAIL=client@example.com
PORTAL_SEED_PASSWORD=replace-with-a-random-password
# VITE_API_BASE_URL=https://api.example.com
